{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": {
    "cyan": "#06B6D4",
    "gradient": {
      "angleDeg": 135,
      "css": "linear-gradient(135deg, #7C3AED 0%, #06B6D4 100%)",
      "from": "#7C3AED",
      "to": "#06B6D4"
    },
    "name": "Vidora",
    "tagline": "Create. Cut. Shine.",
    "violet": "#7C3AED",
    "teal": "#00D9D9"
  },
  "breakpoints": {
    "lg": 1024,
    "md": 768,
    "sm": 640,
    "xl": 1280
  },
  "color": {
    "dark": {
      "accent": "#00D9D9",
      "accent2": "#00B8C4",
      "bg": "#141414",
      "bgHover": "#2A2A2A",
      "bgPanel": "#1E1E1E",
      "bgRaised": "#242424",
      "border": "#2E2E2E",
      "borderStrong": "#3D3D3D",
      "danger": "#F87171",
      "success": "#34D399",
      "text": "#F2F2F2",
      "textFaint": "#6E6E6E",
      "textMuted": "#A8A8A8",
      "timelineAudio": "#2A6F6F",
      "timelineText": "#8A6D2B",
      "timelineVideo": "#3A3A3A",
      "warning": "#FBBF24"
    },
    "light": {
      "accent": "#7C3AED",
      "accent2": "#0891B2",
      "bg": "#F6F6FA",
      "bgHover": "#EDEDF4",
      "bgPanel": "#FFFFFF",
      "bgRaised": "#FFFFFF",
      "border": "#DEDEE8",
      "borderStrong": "#C6C6D6",
      "danger": "#DC2626",
      "success": "#059669",
      "text": "#14141F",
      "textFaint": "#8A8AA0",
      "textMuted": "#55556B",
      "timelineAudio": "#0891B2",
      "timelineText": "#D97706",
      "timelineVideo": "#7C3AED",
      "warning": "#D97706"
    }
  },
  "motion": {
    "durationBaseMs": 200,
    "durationFastMs": 120,
    "durationSlowMs": 320,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "radius": {
    "full": 9999,
    "lg": 12,
    "logo": 24,
    "md": 8,
    "sm": 6,
    "xl": 16
  },
  "shadow": {
    "glowAccent": "0 0 24px rgba(124, 58, 237, 0.45)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.45)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.35)",
    "sm": "0 1px 2px rgba(0, 0, 0, 0.25)"
  },
  "spacing": {
    "lg": 16,
    "md": 12,
    "panelGap": 1,
    "sm": 8,
    "timelineTrackHeight": 56,
    "topBarHeight": 48,
    "xl": 24,
    "xs": 4,
    "xxl": 32
  },
  "typography": {
    "fontFamily": {
      "mono": [
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "monospace"
      ],
      "sans": [
        "Inter",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "scale": {
      "body": {
        "lineHeight": 20,
        "size": 14,
        "weight": 400
      },
      "bodySmall": {
        "lineHeight": 18,
        "size": 13,
        "weight": 400
      },
      "caption": {
        "lineHeight": 16,
        "size": 12,
        "weight": 500
      },
      "display": {
        "lineHeight": 40,
        "size": 32,
        "weight": 700
      },
      "h1": {
        "lineHeight": 32,
        "size": 24,
        "weight": 700
      },
      "h2": {
        "lineHeight": 28,
        "size": 20,
        "weight": 600
      },
      "h3": {
        "lineHeight": 24,
        "size": 16,
        "weight": 600
      },
      "label": {
        "letterSpacing": "0.04em",
        "lineHeight": 14,
        "size": 11,
        "uppercase": true,
        "weight": 600
      }
    }
  }
}