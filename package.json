{
  "dependencies": {
    "gifenc": "^1.0.3",
    "mediabunny": "^1.66.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.3"
  },
  "description": "Vidora \u2014 Create. Cut. Shine. A professional video editor. Phase 3 (text, stickers, captions).",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "name": "vidora",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/unzip-media.mjs",
    "build:assets": "node --import ./scripts/register-ts.mjs scripts/build-assets.mjs",
    "dev": "vite",
    "lint": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm run build && node audit/run-audit.mjs",
    "audit:phase3": "npm run build && node audit/run-audit-phase3.mjs",
    "audit:phase4": "npm run build && node audit/run-audit-phase4.mjs",
    "audit:phase5": "npm run build && node audit/run-audit-phase5.mjs",
    "audit:phase6": "npm run build && node audit/run-audit-phase6.mjs",
    "audit:phase7": "npm run build && node audit/run-audit-phase7.mjs",
    "audit:phase8": "npm run build && node audit/run-audit-phase8.mjs",
    "audit:phase9": "npm run build && node audit/run-audit-phase9.mjs"
  },
  "type": "module",
  "version": "1.0.0"
}
